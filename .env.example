# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA versione o arquivo .env com valores reais.

# Banco de dados (SQLite em arquivo local)
DATABASE_URL=sqlite:///./hotel.db

# JWT — gere uma chave forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-uma-chave-secreta-forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS — origens permitidas, separadas por vírgula (sem espaços)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Usuário administrador criado pelo script de seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
